<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="CopilotChat.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CopilotChat">
    <Application.Resources>
        <ResourceDictionary>

            <local:InitialConverter x:Key="InitialConverter" />
            <local:StringMatchConverter x:Key="StringMatchConverter" />

            <Color x:Key="Primary">#6750A4</Color>
            <Color x:Key="PrimaryLight">#EADDFF</Color>
            <Color x:Key="OnPrimaryLight">#4F378B</Color>
            <Color x:Key="PageBackground">#F7F7FA</Color>
            <Color x:Key="NavBackground">#F2F0F9</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#1D1B20</Color>
            <Color x:Key="TextSecondary">#49454F</Color>
            <Color x:Key="TextTertiary">#79747E</Color>
            <Color x:Key="DividerColor">#E7E0EC</Color>
            <Color x:Key="SurfaceVariant">#E7E0EC</Color>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
