<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CopilotChat.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profile"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <ScrollView Padding="24,20">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="560" HorizontalOptions="Center">

                <!-- Profile avatar -->
                <Border
                    WidthRequest="96" HeightRequest="96"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 48"
                    BackgroundColor="{StaticResource Primary}"
                    HorizontalOptions="Center">
                    <Label
                        x:Name="InitialLabel"
                        TextColor="White"
                        FontSize="38"
                        FontFamily="OpenSansSemibold"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Border
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Name" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Border
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource PageBackground}"
                                Padding="12,0">
                                <Entry
                                    x:Name="NameEntry"
                                    HeightRequest="44"
                                    Placeholder="Enter name" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Border
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource PageBackground}"
                                Padding="12,0">
                                <Entry
                                    x:Name="EmailEntry"
                                    HeightRequest="44"
                                    Keyboard="Email"
                                    Placeholder="Enter email" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Save changes"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    HeightRequest="48"
                    CornerRadius="24"
                    Clicked="OnSaveClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
