<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CopilotChat.Views.CreateAgentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CopilotChat.ViewModels"
    xmlns:local="clr-namespace:CopilotChat.Views"
    Title="Create New Agent"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <ScrollView Padding="24,20">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="560" HorizontalOptions="Center">

                <!-- Logo editor -->
                <local:AgentLogoEditor />

                <Border
                    BackgroundColor="{StaticResource CardBackground}"
                    Stroke="{StaticResource DividerColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="18">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Name" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Border
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource PageBackground}"
                                Padding="12,0">
                                <Entry
                                    Text="{Binding Name}"
                                    Placeholder="Enter agent name"
                                    HeightRequest="44" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Description" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Border
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource PageBackground}"
                                Padding="12,0">
                                <Entry
                                    Text="{Binding Description}"
                                    Placeholder="What does this agent do?"
                                    HeightRequest="44" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Behaviour" FontFamily="OpenSansSemibold" FontSize="13" />
                            <Border
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource PageBackground}"
                                Padding="12,8">
                                <Editor
                                    Text="{Binding Behaviour}"
                                    Placeholder="Describe how the agent should behave…"
                                    AutoSize="TextChanges"
                                    HeightRequest="100" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="Create agent"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    HeightRequest="48"
                    CornerRadius="24"
                    Command="{Binding SaveCommand}" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
