<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CopilotChat.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CopilotChat.Models"
    xmlns:vm="clr-namespace:CopilotChat.ViewModels"
    xmlns:views="clr-namespace:CopilotChat.Views"
    xmlns:assistview="clr-namespace:Syncfusion.Maui.AIAssistView;assembly=Syncfusion.Maui.AIAssistView"
    Title="Copilot"
    BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <!-- Nav item button -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>

        <!-- Agent avatar -->
        <DataTemplate x:Key="AgentAvatarTemplate" x:DataType="models:Agent">
            <Border
                WidthRequest="36" HeightRequest="36"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="{Binding Color}"
                HorizontalOptions="Start">
                <Label
                    Text="{Binding Initial}"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="Auto,1,*">

        <!-- ================= LEFT NAVIGATION ================= -->
        <Grid
            x:Name="NavPanel"
            Grid.Column="0"
            WidthRequest="270"
            BackgroundColor="{StaticResource NavBackground}"
            Padding="12"
            RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
            IsVisible="{Binding IsNavOpen}">

            <!-- Profile row -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="6,4">
                <Border
                    Grid.Column="0"
                    WidthRequest="36" HeightRequest="36"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{Binding Profile.Color}">
                    <Label
                        Text="{Binding Profile.Name, Converter={StaticResource InitialConverter}}"
                        TextColor="White" FontSize="14" FontFamily="OpenSansSemibold"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Column="1"
                    Text="{Binding Profile.Name}"
                    FontFamily="OpenSansSemibold"
                    FontSize="14"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />
            </Grid>

            <!-- New chat -->
            <Button
                Grid.Row="1"
                Style="{StaticResource NavItemStyle}"
                Text="＋  New chat"
                BackgroundColor="{StaticResource PrimaryLight}"
                TextColor="{StaticResource OnPrimaryLight}"
                Command="{Binding NewChatCommand}"
                Margin="0,10,0,4" />

            <!-- Search -->
            <Button
                Grid.Row="2"
                Style="{StaticResource NavItemStyle}"
                Text="🔍  Search"
                Command="{Binding ShowSearchCommand}"
                Margin="0,2" />

            <!-- Library -->
            <Button
                Grid.Row="3"
                Style="{StaticResource NavItemStyle}"
                Text="📚  Library"
                Command="{Binding ShowLibraryCommand}"
                Margin="0,2,0,10" />

            <!-- Chat history -->
            <ScrollView Grid.Row="4">
                <VerticalStackLayout Spacing="2">
                    <Label
                        Text="Recent"
                        FontSize="12"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource TextTertiary}"
                        Padding="16,4" />
                    <CollectionView ItemsSource="{Binding ChatHistory}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatSession">
                                <Grid Padding="4">
                                    <Button
                                        Style="{StaticResource NavItemStyle}"
                                        Text="{Binding Title}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenChatCommand}"
                                        CommandParameter="{Binding .}"
                                        LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Agents -->
                    <Label
                        Text="Agents"
                        FontSize="12"
                        FontFamily="OpenSansSemibold"
                        TextColor="{StaticResource TextTertiary}"
                        Padding="16,12,16,4" />
                    <CollectionView ItemsSource="{Binding Agents}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Agent">
                                <Grid Padding="4">
                                    <Border
                                        HeightRequest="42"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 21"
                                        Padding="14,0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Border
                                                WidthRequest="24" HeightRequest="24"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{Binding Color}"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding Initial}"
                                                    TextColor="White" FontSize="11" FontFamily="OpenSansSemibold"
                                                    HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                TextColor="{StaticResource TextPrimary}"
                                                FontFamily="OpenSansRegular" FontSize="14"
                                                VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenAgentCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Create new agent -->
            <Button
                Grid.Row="5"
                Style="{StaticResource NavItemStyle}"
                Text="✚  New agent"
                Command="{Binding CreateAgentCommand}"
                Margin="0,2" />

            <BoxView Grid.Row="6" HeightRequest="1" Color="{StaticResource DividerColor}" Margin="0,10" />

            <!-- Edit profile -->
            <Button
                Grid.Row="7"
                Style="{StaticResource NavItemStyle}"
                Text="⚙  Profile"
                Command="{Binding EditProfileCommand}"
                HorizontalOptions="Start" />
        </Grid>

        <!-- Nav divider -->
        <BoxView
            Grid.Column="1"
            WidthRequest="1"
            Color="{StaticResource DividerColor}" />

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="2">

            <!-- CHAT VIEW -->
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding CurrentView, Converter={StaticResource StringMatchConverter}, ConverterParameter=Chat}">

                <!-- Chat header -->
                <Grid
                    Grid.Row="0"
                    Padding="16,12"
                    ColumnDefinitions="Auto,*,Auto"
                    BackgroundColor="{StaticResource CardBackground}">
                    <Border
                        WidthRequest="32" HeightRequest="32"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{Binding CurrentAgent.Color, FallbackValue={StaticResource Primary}}">
                        <Label
                            Text="{Binding CurrentAgent.Initial, FallbackValue='C'}"
                            TextColor="White" FontSize="13" FontFamily="OpenSansSemibold"
                            HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                        <Label
                            Text="{Binding CurrentAgent.Name, FallbackValue='Copilot'}"
                            FontFamily="OpenSansSemibold" FontSize="15" LineBreakMode="TailTruncation" />
                        <Label
                            Text="{Binding CurrentAgent.Description, FallbackValue='Your everyday AI companion'}"
                            FontSize="11" TextColor="{StaticResource TextTertiary}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="2"
                        Text="≡"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource TextPrimary}"
                        WidthRequest="40" HeightRequest="40" CornerRadius="20"
                        Command="{Binding ToggleNavCommand}" />
                </Grid>

                <!-- AI AssistView -->
                <assistview:SfAIAssistView
                    x:Name="AssistView"
                    Grid.Row="1"
                    AssistItems="{Binding Messages}"
                    Suggestions="{Binding Suggestions}"
                    RequestCommand="{Binding RequestCommand}"
                    AutoScrollBehavior="ScrollToLastRequest"
                    ShowScrollToBottomButton="True">
                    <assistview:SfAIAssistView.RequestItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{StaticResource Primary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,10"
                                Margin="48,6,0,6"
                                HorizontalOptions="End">
                                <Label Text="{Binding Text}" FontSize="15" TextColor="White" />
                            </Border>
                        </DataTemplate>
                    </assistview:SfAIAssistView.RequestItemTemplate>
                    <assistview:SfAIAssistView.ResponseItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{StaticResource CardBackground}"
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,10"
                                Margin="0,6,48,6"
                                HorizontalOptions="Start">
                                <Label Text="{Binding Text}" FontSize="15" TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </DataTemplate>
                    </assistview:SfAIAssistView.ResponseItemTemplate>
                </assistview:SfAIAssistView>
            </Grid>

            <!-- SEARCH VIEW -->
            <views:SearchView IsVisible="{Binding CurrentView, Converter={StaticResource StringMatchConverter}, ConverterParameter=Search}" />

            <!-- LIBRARY VIEW -->
            <views:LibraryView IsVisible="{Binding CurrentView, Converter={StaticResource StringMatchConverter}, ConverterParameter=Library}" />

        </Grid>
    </Grid>
</ContentPage>
